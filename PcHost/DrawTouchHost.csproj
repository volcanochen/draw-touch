<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：常驻系统托盘，不再弹出控制台窗口 -->
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows 提供 Windows 桌面 SDK，P/Invoke user32 无需任何 NuGet 依赖 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DrawTouchHost</AssemblyName>
    <RootNamespace>DrawTouchHost</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 发布为单文件、自包含，双击即可在任意 Windows 10 1809+ 运行 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 原生库（WPF 的 wpfgfx / PenImc / D3DCompiler 等）也塞进单文件里。
         不加这条的话 zip 里必须单独带 6 个 native dll，少一个就起不来。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
  </ItemGroup>

  <!-- 构建时间戳：每次编译生成 obj/BuildTime.g.cs（托盘菜单 / 设置窗口显示，
       用户用来确认跑的是哪个包） -->
  <Target Name="GenBuildTime" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildTimeText>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildTimeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildTime.g.cs"
                      Lines="namespace DrawTouchHost;%3B internal static partial class BuildInfo %7B public const string BuildTime = &quot;$(BuildTimeText)&quot;%3B }"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildTime.g.cs" />
    </ItemGroup>
  </Target>

</Project>
